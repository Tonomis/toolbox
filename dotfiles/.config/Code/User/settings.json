{
  // visuals
  "telemetry.telemetryLevel": "off",
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "GitHub Dark",
  "workbench.preferredDarkColorTheme": "GitHub Dark",
  "workbench.fontAliasing": "antialiased",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editor.showTabs": "multiple",
  "editor.fontFamily": "Input Mono, Fira Code, monospace",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss06', 'zero'",
  "editor.cursorBlinking": "phase",
  "editor.suggestSelection": "first",
  "editor.wordWrap": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.tabSize": 2,
  "editor.minimap.enabled": false,
  "search.exclude": {
    "**/.git": true,
    "**/.nuxt": true,
    "**/.pnpm": true,
    "**/.vscode": true,
    "**/.yarn": true,
    "**/dist/**": true,
    "**/logs": true,
    "**/node_modules": true,
    "**/out/**": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/yarn.lock": true
  },

  // general
  "editor.unicodeHighlight.invisibleCharacters": false,
  "security.workspace.trust.untrustedFiles": "open",
  // git
  "git.autofetch": true,
  "git.untrackedChanges": "separate",
  // github
  "githubPullRequests.pullBranch": "never",
  // eslint
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "eslint.quiet": true,
  "eslint.validate": [
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "json5"
  ],
  // stylelint
  "css.validate": false,
  "less.validate": true,
  "scss.validate": true,
  "files.associations": {
    "*.css": "postcss",
    "*.hcl": "terraform"
  },
  // languages
  "[javascript]": {
  },
  "javascript.preferences.quoteStyle": "single",
  "javascript.preferences.importModuleSpecifierEnding": "js",
  "javascript.suggest.completeJSDocs": true,
  "javascript.suggest.jsdoc.generateReturns": true,
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "[html]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    },
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true
  },

  "files.autoSave": "afterDelay",
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "projectManager.git.baseFolders": ["/home/florian/Project"],
  "explorer.confirmDelete": false,
  "[python]": {
    "editor.formatOnType": true
  },
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",
  "git.ignoreRebaseWarning": true,
  "explorer.confirmDragAndDrop": false,
  "git.enableCommitSigning": true,
  "editor.inlineSuggest.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false
  },
  "window.restoreWindows": "none",
  "window.menuBarVisibility": "toggle",
  "[jsonc]": {
  },
  "workbench.preferredHighContrastColorTheme": "GitHub Dark",
  "terminal.external.linuxExec": "Konsole",
  "terminal.integrated.tabs.defaultColor": "terminal.ansiBlack",
  "workbench.colorTheme": "GitHub Dark",
  "workbench.preferredHighContrastLightColorTheme": "GitHub Dark",
  // yaml — disable validation globally, re-enable only for plain yaml files
  // (prevents Red Hat YAML extension from validating Helm templates)
  "yaml.validate": false,
  "yaml.schemas": {
    "https://json.schemastore.org/chart.json": "**/helm/Chart.yaml",
    "file:///home/florian/.vscode/extensions/docsmsft.docs-yaml-1.0.6/dist/toc.schema.json": "/toc\\.yml/i"
  },
  "redhat.telemetry.enabled": false,
  "[yaml]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[helm-template]": {
    "editor.formatOnSave": false
  },
  "diffEditor.ignoreTrimWhitespace": false,
  "scm.experimental.showHistoryGraph": true,
  "explorer.confirmPasteNative": false,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "eslint.nodeEnv": "",
  "eslint.nodePath": "~/.local/share/pnpm",
  "github.copilot.advanced": {

    
  },
  "chat.agent.enabled": true,
  "docker.extension.enableComposeLanguageServer": false,
  "github.copilot.selectedCompletionModel": "",
  "markdown.extension.completion.enabled": true,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "chat.tools.terminal.autoApprove": {
    "pnpm": true
  },
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Utiliser le format Conventional Commits avec gitmoji. Format: <type>(<scope>): <gitmoji> <description>. La description est toujours en anglais. Types valides: feat, fix, docs, style, refactor, perf, test, chore, ci, build. Exemples: feat(auth): ✨ add user login, fix(api): 🐛 resolve timeout issue, docs: 📝  update README, style(ui): 🎨 improve button colors, refactor(core): ♻️ simplify logic, perf(db): ⚡️ optimize queries, test(api): ✅ add unit tests, chore(deps): 🔧 update dependencies, ci: 👷 configure GitHub Actions, build: 📦 update webpack config"
    }
  ],
  "claudeCode.preferredLocation": "panel",
  "github.copilot.nextEditSuggestions.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ]
}
