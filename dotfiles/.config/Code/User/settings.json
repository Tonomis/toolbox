{
  // ─────────────────────────────────────────────────────────────
  // visuals
  // ─────────────────────────────────────────────────────────────
  "telemetry.telemetryLevel": "off",
  "window.autoDetectColorScheme": true,
  // Thème sombre en toutes circonstances, y compris en contraste élevé.
  "workbench.preferredLightColorTheme": "GitHub Dark",
  "workbench.preferredDarkColorTheme": "GitHub Dark",
  "workbench.preferredHighContrastColorTheme": "GitHub Dark",
  "workbench.preferredHighContrastLightColorTheme": "GitHub Dark",
  "workbench.colorTheme": "GitHub Dark",
  "workbench.fontAliasing": "antialiased",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editor.showTabs": "multiple",
  "editor.fontFamily": "Input Mono, Fira Code, monospace",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss06', 'zero'",
  "editor.cursorBlinking": "phase",
  "editor.suggestSelection": "first",
  "editor.wordWrap": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.tabSize": 2,
  "editor.minimap.enabled": false,
  "search.exclude": {
    "**/.git": true,
    "**/.nuxt": true,
    "**/.pnpm": true,
    "**/.vscode": true,
    "**/.yarn": true,
    "**/dist/**": true,
    "**/logs": true,
    "**/node_modules": true,
    "**/out/**": true,
    "**/package-lock.json": true,
    "**/pnpm-lock.yaml": true,
    "**/yarn.lock": true
  },

  // ─────────────────────────────────────────────────────────────
  // general
  // ─────────────────────────────────────────────────────────────
  "editor.unicodeHighlight.invisibleCharacters": false,
  "security.workspace.trust.untrustedFiles": "open",
  "files.autoSave": "afterDelay",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "window.restoreWindows": "none",
  "window.menuBarVisibility": "toggle",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.inlineSuggest.enabled": true,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "terminal.integrated.tabs.defaultColor": "terminal.ansiBlack",
  "terminal.external.linuxExec": "Konsole",
  "projectManager.git.baseFolders": ["/home/florian/Projects"],

  // ─────────────────────────────────────────────────────────────
  // git / github
  // ─────────────────────────────────────────────────────────────
  "git.autofetch": true,
  "git.untrackedChanges": "separate",
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.ignoreRebaseWarning": true,
  "git.enableCommitSigning": true,
  "githubPullRequests.pullBranch": "never",
  "scm.experimental.showHistoryGraph": true,

  // ─────────────────────────────────────────────────────────────
  // eslint / stylelint
  // ─────────────────────────────────────────────────────────────
  "editor.codeActionsOnSave": {
    "source.fixAll": "never",
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "eslint.quiet": true,
  "eslint.nodeEnv": "",
  "eslint.nodePath": "~/.local/share/pnpm",
  "eslint.validate": [
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "json5"
  ],
  "css.validate": false,
  "less.validate": true,
  "scss.validate": true,

  // ─────────────────────────────────────────────────────────────
  // file associations
  // ─────────────────────────────────────────────────────────────
  "files.associations": {
    "*.css": "postcss",
    "*.hcl": "terraform",
    "*.tpl": "helm",
    // Charts Helm : templates intégralement templatés.
    "**/charts/**/templates/**/*.yaml": "helm",
    "**/charts/**/templates/**/*.yml": "helm",
    // Argo CD app-of-apps : forcé en yaml, sinon le LSP ne tourne pas.
    "**/apps/**/templates/**/*.yaml": "yaml",
    "**/apps/**/templates/**/*.yml": "yaml"
  },

  // ─────────────────────────────────────────────────────────────
  // languages
  // ─────────────────────────────────────────────────────────────
  "javascript.preferences.quoteStyle": "single",
  "javascript.preferences.importModuleSpecifierEnding": "js",
  "javascript.suggest.completeJSDocs": true,
  "javascript.suggest.jsdoc.generateReturns": true,
  "typescript.preferences.importModuleSpecifierEnding": "js",
  "[html]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    },
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "markdown.extension.completion.enabled": true,
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true
  },
  "[python]": {
    "editor.formatOnType": true
  },

  // ─────────────────────────────────────────────────────────────
  // YAML / Kubernetes
  // ─────────────────────────────────────────────────────────────
  // Indépendant de completion : garde l'autocomplete sans les faux positifs.
  "yaml.validate": false,
  "yaml.completion": true,
  "yaml.hover": true,
  "yaml.format.enable": true,
  "yaml.schemaStore.enable": true,
  "yaml.kubernetesVersion": "1.31",
  "yaml.schemas": {
    // Schéma Kubernetes embarqué (mot-clé spécial "kubernetes").
    "kubernetes": [
      "**/apps/**/templates/*.yaml",
      "**/apps/**/templates/**/*.yaml",
      "**/argo-cd/**/*.yaml",
      "**/bootstrap-manifests/*.yaml",
      "manifests/**/*.yaml",
      "manifests/**/*.yml",
      "base/**/*.yaml",
      "deploy/**/*.yaml",
      "k8s/**/*.yaml",
      "k8s/**/*.yml"
    ],
    "https://json.schemastore.org/chart.json": "**/Chart.yaml",
    "https://json.schemastore.org/chart-lock.json": "**/Chart.lock",
    "https://json.schemastore.org/kustomization.json": "**/kustomization.yaml",
    "https://json.schemastore.org/helmfile.json": "**/helmfile.yaml",
    "https://json.schemastore.org/skaffold.json": "**/skaffold.yaml",
    "https://json.schemastore.org/pre-commit-config.json": "**/.pre-commit-config.yaml"
  },
  "yaml.disableSchemaDetection": [
    // Forks non couverts par l'auto-exclusion de l'extension.
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    // Le formateur reflow les blocs et fait du bruit dans les diffs.
    "editor.formatOnSave": false
  },
  "[helm]": {
    "editor.formatOnSave": false,
    "editor.tabSize": 2
  },
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.quickSuggestions": {
      "other": true,
      "comments": false,
      "strings": true
    },
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "redhat.telemetry.enabled": false,
  "docker.extension.enableComposeLanguageServer": false,

  // ─────────────────────────────────────────────────────────────
  // kubernetes tools
  // ─────────────────────────────────────────────────────────────
  "vs-kubernetes": {
    "vs-kubernetes.crd-code-completion": "enabled",
    "disable-linters": ["resource-limits"]
  },

  // ─────────────────────────────────────────────────────────────
  // copilot / chat
  // ─────────────────────────────────────────────────────────────
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
    "yaml": true,
    "helm": true
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Generate commit messages using Conventional Commits with a gitmoji. Format: <type>(<scope>): <gitmoji> <description>. The scope is optional; omit the parentheses entirely when the change spans the whole repository. Always write in English."
    },
    {
      "text": "Description rules: use the imperative mood (\"add\", not \"added\" or \"adds\"), start with a lowercase letter, do not end with a period, and keep the subject line under 72 characters. Describe what the change does, not which files were touched. For breaking changes append an exclamation mark after the type or scope (e.g. feat(api)!: ...) and add a BREAKING CHANGE footer explaining the migration."
    },
    {
      "text": "Valid types: feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert. Pick the single most specific gitmoji for the change; never use more than one. When several apply, prefer the one describing the intent over the one describing the mechanism. If nothing fits well, fall back to the emoji matching the type: ✨ feat, 🐛 fix, 📝 docs, 💄 style, ♻️ refactor, ⚡️ perf, ✅ test, 🔧 chore, 👷 ci, 📦️ build, ⏪️ revert."
    },
    {
      "text": "Gitmoji reference — Features and UX: ✨ new feature, 🚸 improve usability / UX, 💄 UI or style files, 💫 animations and transitions, 📱 responsive design, ♿️ accessibility, 🌐 i18n / l10n, ✈️ offline support, 🚩 feature flags, 🥚 easter egg | Bug fixes and error handling: 🐛 bug fix, 🚑️ critical hotfix, 🩹 minor non-critical fix, 🚨 fix compiler or linter warnings, 💚 fix CI build, ✏️ fix typos, 🥅 catch errors, 🦺 validation code, 🛂 authorization, roles, permissions | Refactoring and code health: ♻️ refactor, 🎨 improve code structure or format, ⚡️ improve performance, 🔥 remove code or files, ⚰️ remove dead code, 🗑️ deprecate code, 💩 knowingly bad code to revisit, 🏗️ architectural changes, 👔 business logic, 🧵 multithreading or concurrency, 🦖 backwards compatibility, 👽️ update due to external API changes, 🚚 move or rename resources, 💥 breaking changes | Tests: ✅ add, update, or pass tests, 🧪 add a failing test, 📸 snapshots, 🤡 mocks, ⚗️ experiments | Documentation and metadata: 📝 documentation, 💡 comments in source code, 💬 text and literals, 📄 license, 👥 contributors, 🏷️ types."
    },
    {
      "text": "Gitmoji reference (continued) — Dependencies and configuration: ⬆️ upgrade dependencies, ⬇️ downgrade dependencies, ➕ add a dependency, ➖ remove a dependency, 📌 pin dependencies, 🔧 configuration files, 🔨 development scripts, 🙈 .gitignore, 📦️ compiled files or packages | CI, release and infrastructure: 👷 CI build system, 🚀 deployment, 🧱 infrastructure changes, 🩺 healthcheck, 🔖 release or version tag, 🔀 merge branches, ⏪️ revert changes, 🚧 work in progress | Data and observability: 🗃️ database changes, 🌱 seed files, 🔊 add or update logs, 🔇 remove logs, 📈 analytics or tracking, 🧐 data exploration or inspection, 🔍️ SEO | Security: 🔒️ fix security or privacy issue, 🔐 add or update secrets | Project and miscellaneous: 🎉 initial commit / begin a project, 🍱 assets, 🧑‍💻 developer experience, 💸 sponsorship or money-related infrastructure, 🍻 code written without much care."
    },
    {
      "text": "Examples: feat(auth): ✨ add SSO login via OIDC | fix(api): 🐛 handle empty payload on webhook retry | perf(db): ⚡️ batch cluster status queries | ci: 👷 run helm lint on pull requests | chore(deps): ⬆️ bump argo-cd chart to 7.8.2 | refactor(core)!: 💥 drop the legacy config loader"
    }
  ],
  "chat.agent.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "chat.tools.terminal.autoApprove": {
    "pnpm": true
  },
  "claudeCode.preferredLocation": "panel"
}
